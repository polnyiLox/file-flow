APP_CONFIG__MONGODB__USER=mongo
APP_CONFIG__MONGODB__PASSWORD=change_me
APP_CONFIG__MONGODB__HOST=mongodb
APP_CONFIG__MONGODB__PORT=27017
APP_CONFIG__MONGODB__NAME=start_app
APP_CONFIG__MONGODB__AUTH_SOURCE=admin

APP_CONFIG__API__V1_PREFIX=/v1
APP_CONFIG__API__HOST=0.0.0.0
APP_CONFIG__API__PORT=8000
APP_CONFIG__API__RELOAD=false

APP_CONFIG__MIDDLEWARE__ALLOW_ORIGINS=["http://localhost:3000"]
APP_CONFIG__MIDDLEWARE__ALLOW_METHODS=["*"]
APP_CONFIG__MIDDLEWARE__ALLOW_HEADERS=["*"]
APP_CONFIG__MIDDLEWARE__ALLOW_CREDENTIALS=true

MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_INITDB_DATABASE=start_app
